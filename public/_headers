# Cloudflare static-asset caching rules.
# Files in /_astro/ have a content hash in their name, so they never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Robot model, sounds and stylesheet: reuse for an hour, then refresh quietly in the background.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# Fonts: they change only if renamed, so cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
