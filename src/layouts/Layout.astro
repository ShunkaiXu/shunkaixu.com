---
interface Props {
  title: string;
  page: string;
  description?: string;
}
const { title, page } = Astro.props;
// a short description for search results and link previews (Home passes its own)
const DESC = {
  home: 'Shunkai Xu plays the cello, builds iPhone apps and programs robots.',
  projects: 'Kept, Tempo, the drawing robot arm and smaller projects by Shunkai Xu.',
  music: 'Shunkai Xu on the cello: what he is working on, summer programmes, performances and competitions.',
  posts: 'Notes by Shunkai Xu on building things and on practice.',
  interests: 'What Shunkai Xu follows: computational economics, Formula 1, football and algorithms.',
  about: 'Shunkai Xu, a high school student in Shanghai who plays the cello, builds iPhone apps and writes robot code.',
};
const description = Astro.props.description || DESC[page] || DESC.home;
const url = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
// the bottom tab bar on phones (app-like); icons are simple 24px line drawings
const tabs = [
  { p: 'home', href: '/', label: 'Home', icon: 'M3.5 10.5 12 3.8l8.5 6.7V20a1 1 0 0 1-1 1H15v-6.2H9V21H4.5a1 1 0 0 1-1-1Z' },
  { p: 'projects', href: '/projects', label: 'Projects', icon: 'M4 4h6.5v6.5H4ZM13.5 4H20v6.5h-6.5ZM4 13.5h6.5V20H4ZM13.5 13.5H20V20h-6.5Z' },
  { p: 'music', href: '/music', label: 'Music', icon: 'M9 18.2V5.6L20 3.4v12.4M9 18.2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM20 15.8a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z' },
  { p: 'interests', href: '/interests', label: 'Interests', icon: 'M4 3.5V20h16.5M7.5 15.5l4-4.5 3 3 5-6.5' },
  { p: 'about', href: '/about', label: 'About', icon: 'M16 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21c.6-4 3.8-6 8-6s7.4 2 8 6' },
];
import { SKY } from '../lib/skyline.js';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<script is:inline>try{var t=localStorage.getItem('site-theme')||'light';document.documentElement.dataset.siteTheme=t}catch(e){}</script>
<link rel="preload" href="/fonts/newsreader-text.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/newsreader-display.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/caveat-brush.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css">
<style is:inline>.tabbar{display:none}
/* page transitions: modern browsers cross-fade between pages; the header and tab bar stay put,
   and the big page title slides in. Nothing happens for visitors who prefer reduced motion. */
/* first-visit sound hint (src/scripts/site.js) */
.shint{position:fixed;z-index:60;width:min(320px,calc(100vw - 24px));padding:14px 16px 14px;background:var(--sheet);border:1px solid var(--rule);border-radius:var(--hint-r,3px);
  box-shadow:0 10px 30px rgba(0,0,0,.10),0 1px 3px rgba(0,0,0,.06);color:var(--ink);font-size:15px;line-height:1.4;opacity:0;transform:translateY(-6px);transition:opacity .3s,transform .4s cubic-bezier(.2,.8,.2,1)}
.shint::before{content:"";position:absolute;top:-6px;right:var(--nib,14px);width:10px;height:10px;background:var(--sheet);border-left:1px solid var(--rule);border-top:1px solid var(--rule);transform:rotate(45deg)}
.shint.on{opacity:1;transform:none}
.shint b{display:block;font-weight:600;margin-bottom:2px}
.shint p{margin:0;color:var(--ink-2)}
.shint .row{display:flex;gap:8px;margin-top:12px}
.shint .row button{-webkit-appearance:none;appearance:none;height:32px;padding:0 13px;border-radius:var(--hint-b,0);border:1px solid var(--rule);background:transparent;color:var(--ink);font-family:var(--mono);font-size:14px;cursor:pointer}
.shint .row .go{background:var(--ink);border-color:var(--ink);color:var(--paper)}
.shint .row button:hover{border-color:var(--ink)}
.sound.hinted .led{background:var(--orange);animation:shint-led 1.4s ease-in-out infinite}
@keyframes shint-led{50%{box-shadow:0 0 0 5px rgba(255,90,31,.22)}}
@media (prefers-reduced-motion:reduce){.shint{transition:opacity .2s}.sound.hinted .led{animation:none}}
/* reveals (src/scripts/reveal.js) */
.rv{opacity:0;transform:translateY(16px)}
.rv.rv-in{opacity:1;transform:none;transition:opacity .7s cubic-bezier(.2,.8,.2,1) var(--rv-d,0ms),transform .8s cubic-bezier(.2,.8,.2,1) var(--rv-d,0ms)}
/* list rows: a small orange arrow slides in on hover (mouse only) */
@media (hover:hover){
  .spec > a .t::after{content:"\2192";display:inline-block;margin-left:.35em;color:var(--orange);opacity:0;transform:translateX(-6px);transition:opacity .25s,transform .35s cubic-bezier(.2,.8,.2,1)}
  .spec > a:hover .t::after{opacity:1;transform:none}
  /* footer links: an underline that draws in from the left */
  .fb-links a{text-decoration:none;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size .35s cubic-bezier(.2,.8,.2,1),color .2s}
  .fb-links a:hover{background-size:100% 1px}
}
/* links inside text: a faint underline that turns orange on hover */
main p a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px;text-decoration-color:color-mix(in srgb,currentColor 35%,transparent);transition:text-decoration-color .2s,color .2s}
main p a:hover{text-decoration-color:var(--orange)}
@media (prefers-reduced-motion:no-preference){
  @view-transition{navigation:auto}
  .top{view-transition-name:chrome}
  .tabbar{view-transition-name:tabs}
  .head h1{view-transition-name:title}
  ::view-transition-old(root){animation:vt-out .22s cubic-bezier(.4,0,1,1) both}
  ::view-transition-new(root){animation:vt-in .42s cubic-bezier(.2,.8,.2,1) both}
  ::view-transition-old(title){animation:vt-out .2s ease both}
  ::view-transition-new(title){animation:vt-title .55s cubic-bezier(.2,.8,.2,1) both}
  @keyframes vt-out{to{opacity:0}}
  @keyframes vt-in{from{opacity:0;transform:translateY(10px)}}
  @keyframes vt-title{from{opacity:0;transform:translateY(22px)}}
}
</style>
<link rel="stylesheet" href="/assets/phone.css" media="(max-width: 760px)">

<title>{title}</title>
<meta name="description" content={description}>
{(page === 'posts' || page === '404') && <meta name="robots" content="noindex">}
<link rel="canonical" href={url}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#F3F3F0" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Shunkai Xu">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={og}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Shunkai Xu, with a golden-ratio spiral drawing">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={og}>
<slot name="head" />
</head>
<body data-page={page}>
<a class="vh" href="#main">Skip to content</a>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Shunkai Xu, home"><span>Shunkai Xu</span><i aria-hidden="true"></i></a>
    <nav class="nav" aria-label="Pages">
      <a data-p="home" href="/">Home</a>
      <a data-p="projects" href="/projects">Projects</a>
      <a data-p="music" href="/music">Music</a>
      <a data-p="interests" href="/interests">Interests</a>
      <a data-p="about" href="/about">About</a>
    </nav>
    <button class="menu" id="menu" type="button" aria-expanded="false">Menu</button>
    <div class="right">
      <button class="theme" id="theme" type="button" aria-label="Switch light or dark"><svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3"/></svg><svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7z"/></svg></button>
      <button class="sound" id="sound" type="button" aria-pressed="false"><span class="led" aria-hidden="true"></span><span id="sound-label">Sound off</span></button>
    </div>
  </div>
</header>

<slot />
<footer class="foot">
  <div class="wrap">
    <figure class="sky" id="sky">
      <figcaption class="sky-cap"><span class="cap-text">Lujiazui, Shanghai, seen from the Bund.</span><span class="mono"><time id="sh-time">Shanghai</time></span></figcaption>
      <svg viewBox="0 0 1200 230" preserveAspectRatio="xMidYMax meet" role="img" aria-label="A line drawing of the Shanghai skyline: the Oriental Pearl Tower, Jin Mao Tower, World Financial Center and Shanghai Tower above the Huangpu river">
        <g class="sk-b">{SKY.blocks.map((d, i) => <path d={d} pathLength="1" style={`--i:${i % 23}`} />)}</g>
        <g class="sk-l">
          <path d={SKY.tower} pathLength="1" style="--i:0" /><path class="thin" d={SKY.towerTwist} pathLength="1" style="--i:2" />
          <path d={SKY.swfc} pathLength="1" style="--i:1" /><path class="thin" d={SKY.swfcHole} pathLength="1" style="--i:4" />
          <path d={SKY.jin} pathLength="1" style="--i:2" /><path d={SKY.jinMast} pathLength="1" style="--i:5" />
          {SKY.pearl.map((d, i) => <path d={d} pathLength="1" style={`--i:${i + 3}`} />)}
          {SKY.spheres.map(([x, y, r], i) => <circle class="orb" cx={x} cy={y} r={r} pathLength="1" style={`--i:${i + 4}`} />)}
        </g>
        <path class="sk-g" d="M0 200H1200" pathLength="1" />
        <g class="sk-r">{SKY.river.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}</g>
      </svg>
    </figure>
    <div class="fb">
      <div class="fb-id">
        <span class="fb-sig">Shunkai Xu</span>
        <span class="mono fb-meta">Shanghai · 2026</span>
      </div>
      <nav class="fb-links mono" aria-label="Elsewhere">
        <a href="mailto:shunkai_xu@163.com">Email</a>
        <a href="https://github.com/ShunkaiXu">GitHub</a>
        <a href="https://github.com/ShunkaiXu/shunkaixu.com">View source</a>
        <a href="/about">About</a>
      </nav>
    </div>
    <section class="hello" id="hello" aria-label="Where visitors are from" hidden>
      <div class="hello-h mono"><span>Hello from</span><span id="hello-n"></span></div>
      <ol class="hello-list mono" id="hello-list"></ol>
    </section>
  </div>
</footer>
<style is:inline>
.foot{border-top:0;padding-block:var(--half) var(--half);color:var(--muted)}
.sky{margin:0 0 var(--s5)}
.sky-cap{display:flex;justify-content:space-between;align-items:baseline;gap:var(--s3);flex-wrap:wrap;color:var(--muted);margin-bottom:var(--s3)}
.sky svg{display:block;width:100%;height:auto;overflow:visible}
.sky path,.sky circle{fill:none;stroke-linecap:round;stroke-linejoin:round}
.sk-b path{stroke:color-mix(in srgb,var(--ink) 22%,transparent);stroke-width:1;fill:var(--paper)}
.sk-l path{stroke:var(--ink);stroke-width:1.5;fill:var(--paper)}
.sk-l .thin{stroke-width:1;fill:none}
.sk-l .orb{stroke:var(--ink);stroke-width:1.5;fill:var(--paper)}
.sk-g{stroke:var(--ink);stroke-width:1}
.sk-r path{stroke:color-mix(in srgb,var(--ink) 25%,transparent);stroke-width:1}
@media (prefers-reduced-motion:no-preference){
  .sky.arm path,.sky.arm circle{stroke-dasharray:1 1;stroke-dashoffset:1;fill-opacity:0}
  .sky.arm.in path,.sky.arm.in circle{stroke-dashoffset:0;fill-opacity:1;transition:stroke-dashoffset 1.4s cubic-bezier(.6,.05,.3,1) calc(var(--i,0) * 60ms),fill-opacity .6s ease calc(var(--i,0) * 60ms + 900ms)}
  .sky.arm.in .sk-g{transition-duration:1.1s;transition-delay:0s}
  .sky.arm.in .sk-b path{transition-delay:calc(200ms + var(--i,0) * 25ms),calc(800ms + var(--i,0) * 25ms)}
  .sky.arm.in .sk-l path,.sky.arm.in .sk-l circle{transition-duration:1.8s,.6s;transition-delay:calc(500ms + var(--i,0) * 140ms),calc(1700ms + var(--i,0) * 140ms)}
  .sky.arm.in .sk-r path{transition-delay:calc(900ms + var(--i,0) * 150ms)}
}
.foot .wrap{display:block}
.fb{display:flex;justify-content:space-between;align-items:flex-end;gap:var(--s4);flex-wrap:wrap}
.fb-id{display:grid;gap:6px}
.fb-sig{font-family:"Caveat Brush","Marker Felt",cursive;font-size:38px;line-height:1;color:var(--ink);display:inline-flex;align-items:flex-end}
.fb-sig i{display:inline-block;width:7px;height:7px;background:var(--orange);margin:0 0 9px 6px}
.fb-meta,.fb-links{font-size:14px}
.fb-links{display:flex;gap:var(--s4);flex-wrap:wrap}
.fb-links a{text-decoration:none;color:var(--ink-2)}
.fb-links a:hover{color:var(--ink)}
.hello{margin-top:var(--s5);border:1px solid var(--rule);background:var(--sheet)}
.hello-h{display:flex;justify-content:space-between;gap:var(--s3);padding:10px 14px;border-bottom:1px solid var(--rule);font-size:13px;letter-spacing:.06em;text-transform:uppercase}
.hello-h span:first-child{color:var(--ink)}
.hello-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));list-style:none;margin:0;padding:0}
.hello-list li{display:flex;align-items:center;gap:8px;padding:8px 14px;font-size:14px;border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);margin:0 -1px -1px 0}
.hello-list .c{color:var(--muted);min-width:2.2em}
.hello-list .nm{color:var(--ink);font-family:var(--sans,inherit);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.hello-list .v{margin-left:auto;font-variant-numeric:tabular-nums}
</style>
<nav class="tabbar" aria-label="Pages">
  {tabs.map(t => <a href={t.href} data-p={t.p} aria-current={t.p === page ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={t.icon}/></svg><span>{t.label}</span></a>)}
</nav>

<script>
import '../scripts/hello.js';
import '../scripts/reveal.js';
import '../scripts/sky.js';
</script>
</body>
</html>
