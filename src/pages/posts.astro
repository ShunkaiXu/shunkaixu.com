---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Posts · Shunkai Xu" page="posts">
<style is:inline slot="head">
.tags{display:flex;gap:var(--s2);flex-wrap:wrap;margin-bottom:var(--s4)}
.spec li[hidden]{display:none}
</style>

<main id="main" class="wrap page">
  <div class="head">
    <span class="fig mono">Sheet 4 / Posts</span>
    <h1>Posts</h1>
    <p>Notes on building things and on practice. The first ones are being written now.</p>
  </div>
  <div class="tags" role="group" aria-label="Filter by tag">
    <button class="btn on" type="button" data-tag="all" aria-pressed="true">All</button>
    <button class="btn" type="button" data-tag="robots" aria-pressed="false">Robots</button>
    <button class="btn" type="button" data-tag="cello" aria-pressed="false">Cello</button>
    <button class="btn" type="button" data-tag="apps" aria-pressed="false">Apps</button>
    <button class="btn" type="button" data-tag="code" aria-pressed="false">Code</button>
  </div>
  <ul class="spec" id="list">
    <li data-tags="robots code"><span class="n">Draft</span><span class="t">Teaching a robot arm to write</span><span class="d">Inverse kinematics, pen speed, and why the letters wobbled at first.</span><span class="m">Robots, code</span></li>
    <li data-tags="cello"><span class="n">Draft</span><span class="t">Practising Elgar</span><span class="d">What the first movement asks of the left hand.</span><span class="m">Cello</span></li>
    <li data-tags="apps code"><span class="n">Draft</span><span class="t">Building Kept</span><span class="d">Designing a journal app that never sends your data anywhere.</span><span class="m">Apps, code</span></li>
    <li data-tags="cello code"><span class="n">Draft</span><span class="t">Sound on a website</span><span class="d">How to make UI sound that nobody wants to turn off.</span><span class="m">Cello, code</span></li>
  </ul>
</main>

<script>
import '../scripts/site.js';
</script>
<script>
const bs = [...document.querySelectorAll('[data-tag]')], items = [...document.querySelectorAll('#list li')];
bs.forEach(b => b.addEventListener('click', () => {
  const t = b.dataset.tag; bs.forEach(x => { const on = x === b; x.classList.toggle('on', on); x.setAttribute('aria-pressed', on); });
  items.forEach(li => li.hidden = t !== 'all' && !li.dataset.tags.split(' ').includes(t));
}));
</script>
</Layout>
