<script>
import '../scripts/site.js';
import '../scripts/home.js';
import '../scripts/player.js';
import '../scripts/finale.js';
import { Sound, $ } from '../scripts/site.js';
// the stage clip plays muted on its own while it is on screen; Unmute turns its sound (and the site's Sound) on
const fig = $('#stage-clip'), v = fig && fig.querySelector('video');
if (v) {
  const sbtn = $('#sound'), ub = fig.querySelector('.vplay'), lbl = ub.querySelector('.lbl');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let seen = false;
  const check = () => {
    const r = fig.getBoundingClientRect(), vis = r.bottom > 0 && r.top < innerHeight;
    if (vis && !seen && !still) { seen = true; v.preload = 'auto'; }
    if (vis && (!still || !v.muted)) { if (v.paused) v.play().catch(() => {}); } else if (!vis && !v.paused) v.pause();
  };
  addEventListener('scroll', check, { passive: true }); addEventListener('resize', check); check();
  const setMuted = m => { v.muted = m; ub.setAttribute('aria-pressed', String(!m)); lbl.textContent = m ? 'Unmute' : 'Mute'; };
  ub.addEventListener('click', () => {
    if (v.muted) { if (!Sound.on) sbtn.click(); setMuted(false); v.currentTime = 0; v.play().catch(() => {}); }
    else setMuted(true);
  });
  sbtn.addEventListener('click', () => { if (!Sound.on) setMuted(true); });
}
</script>
