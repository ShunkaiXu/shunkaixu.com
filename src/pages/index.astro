---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Shunkai Xu" page="home" description="Shunkai Xu plays the cello, builds iPhone apps and programs robots.">
<link rel="preload" href="/assets/ur5e.glb" as="fetch" crossorigin="anonymous" slot="head">
<style is:inline slot="head">
.hero{position:relative;height:max(600px,calc(100svh - 56px));overflow:hidden}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;outline:0}
.hero .cap{position:absolute;left:var(--pad);right:var(--pad);bottom:var(--s5);display:flex;justify-content:space-between;align-items:end;gap:var(--s4);flex-wrap:wrap;pointer-events:none;z-index:var(--z-object)}
.hero .cap > *{pointer-events:auto}
.hero .fig{display:grid;gap:4px;padding:8px 11px;margin-left:-11px;background:color-mix(in srgb,var(--paper) 86%,transparent);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
.hero .fig b{font-family:var(--serif);font-weight:400;font-size:18px;line-height:1.35;color:var(--ink)}
.hero .fig span{color:var(--muted)}
.hero .tools{display:flex;gap:var(--s2)}
.hero .corner{position:absolute;top:var(--s4);left:var(--pad);right:var(--pad);display:flex;justify-content:space-between;align-items:center;color:var(--muted);pointer-events:none;z-index:var(--z-object)}.hero .corner .tools{pointer-events:auto}.hero .btn{background:color-mix(in srgb,var(--paper) 80%,transparent)}
.hero .wait{position:absolute;inset:0;display:grid;place-items:center;color:var(--muted)}
.hero.live .wait{display:none}
.intro{padding-block:var(--sec) var(--half)}
.intro h2{font-size:clamp(40px,5.4vw,84px);line-height:1;letter-spacing:-.025em}
.intro h2 span{color:var(--muted)}
.intro .lead{grid-column:1/8}
.intro .lead p{margin-top:var(--s5);max-width:30em;font-size:21px;line-height:1.45;color:var(--ink-2)}
.portrait{grid-column:9/13;justify-self:end;width:min(100%,380px);margin:0}
.portrait .vid{position:relative;aspect-ratio:4/5;background:var(--surface);overflow:hidden}
.portrait video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.vplay{-webkit-appearance:none;appearance:none;position:absolute;right:10px;bottom:10px;display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 13px 0 11px;border:0;border-radius:999px;
  background:color-mix(in srgb,var(--paper) 88%,transparent);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);color:var(--ink);font:500 15px/1 var(--serif);cursor:pointer}
.vplay svg{width:16px;height:16px;fill:currentColor}
.vplay .on{display:none}.vplay[aria-pressed="true"] .on{display:block;color:var(--orange)}.vplay[aria-pressed="true"] .off{display:none}
.portrait figcaption{margin-top:var(--s2);font-size:15px}
.doors{margin-top:var(--sec)}
.board{margin-top:var(--s5);border-top:1px solid var(--ink)}
.board li{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center;padding:var(--s3) 0;border-bottom:1px solid var(--rule)}
.board .k{grid-column:1/4;color:var(--muted)}
.board .cells{grid-column:4/-1;display:flex;flex-wrap:wrap;gap:3px}
.cell{display:inline-grid;place-items:center;width:clamp(15px,2.1vw,30px);height:clamp(24px,3.1vw,44px);background:var(--cell);color:var(--cell-ink);font-family:var(--mono);font-size:clamp(12px,1.6vw,22px);border-radius:2px;position:relative;overflow:hidden}
.cell::after{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(0,0,0,.6);opacity:0;transition:opacity .3s}
.cell.f::after{opacity:1;transition:none}
.cell.f{animation:flap .11s linear}
@keyframes flap{0%{transform:perspective(200px) rotateX(0)}50%{transform:perspective(200px) rotateX(-70deg)}100%{transform:perspective(200px) rotateX(0)}}
.sect{padding-block:var(--half)}
.sect h2{font-size:clamp(29px,3.2vw,47px)}
.play .cols{align-items:center}
.play .pick{grid-column:1/8}
.play h2{margin-top:var(--s3)}
.play .side{color:var(--ink-2);font-size:16.5px;margin-top:var(--s4);max-width:36em}
.pieces{margin-top:var(--s5)}
.spec.pieces > li{display:block;padding:0;border:0}
.pieces button{-webkit-appearance:none;appearance:none;display:grid;grid-template-columns:2.2em 1fr auto;gap:12px;align-items:baseline;width:100%;padding:var(--s3) 0;border:0;border-bottom:1px solid var(--rule);background:none;text-align:left;cursor:pointer;font:inherit;color:inherit}
.pieces button .n{font-family:var(--mono);font-size:13.5px;color:var(--muted)}
.pieces button .t{font-family:var(--display);font-weight:400;letter-spacing:-.01em;font-size:24px}
.pieces button .t small{display:block;font-family:var(--serif);font-style:italic;font-weight:400;font-size:16px;color:var(--muted);letter-spacing:0}
.pieces button .m{font-family:var(--mono);font-size:13px;color:var(--muted)}
.pieces button:hover .t{color:var(--ink);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
.pieces button[aria-pressed="true"] .n{color:var(--orange)}
.pieces button[aria-pressed="true"] .n::before{content:"▶ "}
.pieces button[disabled]{cursor:default;opacity:.55}
.pieces button[disabled]:hover .t{color:inherit}
.now{display:grid;grid-template-columns:1fr minmax(80px,30%) auto;gap:14px;align-items:center;margin-top:var(--s4);color:var(--muted);font-size:13.5px}
.credit{margin-top:var(--s4);font-size:13px;color:var(--muted)}
.now .bar{height:2px;background:var(--rule);position:relative}
.now .bar i{position:absolute;left:0;top:0;bottom:0;width:0;background:var(--orange)}
.play .stage{grid-column:8/13}
.cellobox{position:relative;aspect-ratio:940/1660;width:min(100%,calc(84vh * 940 / 1660),480px);margin:0 0 0 auto}
.cello-sway{position:absolute;inset:0;transform-origin:50% 92%;will-change:transform}
.cellobox svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.intro .cols{position:relative}
@media (max-width:860px){.hero{height:min(640px,82svh)}.play .pick,.play .stage{grid-column:1/-1}.play .stage{margin-top:var(--s5)}.intro .lead,.portrait{grid-column:1/-1}.portrait{justify-self:start;margin-top:var(--s5)}.board .k,.board .cells{grid-column:1/-1}.board .k{margin-bottom:6px}}
.finale{position:relative;padding-block:var(--half) var(--sec)}
.finale .stage{display:block}
.mod{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:24px;align-items:center;width:100%}
.mod-fig{grid-column:1/8;margin:0}
.mod-cap{display:grid;gap:4px;margin-top:var(--s4);padding-top:var(--s3);border-top:1px solid var(--rule);font-size:16px;font-style:italic;color:var(--muted);max-width:40em}
.mod-cap b{font-family:var(--mono);font-style:normal;font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:400;color:var(--ink)}
.mod-art svg{display:block;width:100%;height:auto;overflow:visible}
.mod-art .ln{fill:none;stroke:var(--ink);stroke-width:1.1}
.mod-art .dim{fill:none;stroke:var(--blue);stroke-width:1}
.mod-art .sp{fill:none;stroke:var(--orange);stroke-width:2.2;stroke-linecap:round}
.mod-art text{font-family:var(--mono);font-size:30px;fill:var(--muted)}
.mod-art .tb{fill:var(--blue)}
.mod-art .rr{fill:var(--orange)}.mod-art .rb{fill:var(--blue)}
.mod-art .ro{fill:var(--paper);stroke:var(--ink);stroke-width:1}
.mod-end{grid-column:9/13}
.mod-name{font-size:clamp(52px,6.4vw,104px);font-weight:400;letter-spacing:-.03em;line-height:.95;margin:0;opacity:0;will-change:opacity,transform}
.fquote{margin:var(--s5) 0 0;opacity:0;will-change:opacity,transform}
.fquote p{font-family:var(--display);font-style:italic;font-size:clamp(26px,2.6vw,40px);font-weight:400;letter-spacing:-.01em;line-height:1.12;margin:0}
.fquote p span{display:block;color:var(--muted)}
.fquote cite{display:block;margin-top:var(--s3);font-style:normal;font-size:13.5px;color:var(--muted);letter-spacing:.04em}
@media (max-width:860px){.mod-fig,.mod-end{grid-column:1/-1}.mod-end{margin-top:var(--s5)}}
@media (max-width:640px){.finale{padding-block:var(--s6)}}

/* loading screen: a cello outline drawn in ink as the page loads */
html.loading{overflow:hidden}
.loader{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;background:var(--paper);transition:opacity .6s ease,visibility 0s linear .6s}
.loader.gone{opacity:0;visibility:hidden}
/* only shown when loading is slow: it fades in after a third of a second, so a quick (cached) visit never sees it */
.loader{animation:ld-in .35s ease .35s both}
@keyframes ld-in{from{opacity:0}}
.loader .lc{display:grid;justify-items:center;gap:var(--s4)}
.loader svg{height:min(58vh,540px);width:auto;overflow:visible}
.loader .ink{fill:none;stroke:var(--ink);stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round}
.loader .lvl{fill:var(--orange)}
.loader .tip{fill:var(--orange)}
.loader .pct{font-family:var(--mono);font-size:13.5px;color:var(--muted);letter-spacing:.04em;font-variant-numeric:tabular-nums}
</style>

<div class="loader" id="loader" role="progressbar" aria-label="Loading the page" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
  <div class="lc">
    <svg viewBox="-240 -500 480 1660" aria-hidden="true">
