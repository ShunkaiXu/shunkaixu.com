<script is:inline>
// Loading screen. home.js reports progress with __loader.set(0..1) and calls __loader.done() when the scene is ready.
(function () {
  var el = document.getElementById('loader'), path = el.querySelector('.ink'), tip = el.querySelector('.tip'), pct = el.querySelector('.pct'), fill = el.querySelector('.lfill'), lvl = el.querySelector('.lvl');
  var len = path.getTotalLength(), target = .03, shown = 0, finished = false, onGone = [], t0 = performance.now();
  document.documentElement.classList.add('loading');
  function gone() { el.classList.add('gone'); document.documentElement.classList.remove('loading'); onGone.splice(0).forEach(function (f) { f(); }); }
  function frame(now) {
    if (el.classList.contains('gone')) return;
    // ease toward the real progress; creep slowly on long waits so it never looks frozen
    var creep = Math.min(.12, (now - t0) / 60000);
    shown += (Math.max(target, Math.min(.9, target + creep)) - shown) * (finished ? .2 : .08);
    if (finished && shown > .995) shown = 1;
    // first the ink outline is drawn (0 to 60%), then varnished wood fills it from the bottom up (45 to 100%)
    var d = Math.min(1, shown / .6), k = Math.max(0, Math.min(1, (shown - .45) / .55)), y = 1150 - k * 1650;
    path.style.strokeDashoffset = 1 - d;
    var p = path.getPointAtLength(len * d); tip.setAttribute('cx', p.x); tip.setAttribute('cy', p.y); tip.setAttribute('opacity', d > .005 && d < 1 ? 1 : 0);
    fill.setAttribute('y', y); lvl.setAttribute('y', y - 2.5); lvl.setAttribute('opacity', k > 0 && k < 1 ? 1 : 0);
    var n = Math.round(shown * 100); pct.textContent = n + '%'; el.setAttribute('aria-valuenow', n);
    if (shown >= 1) { setTimeout(gone, 500); return; }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
  window.__loader = {
    set: function (p) { target = Math.max(target, Math.min(1, p)); },
    done: function () { finished = true; target = 1; if (performance.now() - t0 < 350) { gone(); return; }   // ready before it ever appeared: skip it
      setTimeout(function () { if (!el.classList.contains('gone')) { path.style.strokeDashoffset = 0; fill.setAttribute('y', -500); pct.textContent = '100%'; gone(); } }, 1500); },
    whenGone: function () { return new Promise(function (r) { el.classList.contains('gone') ? r() : onGone.push(r); }); }
  };
  setTimeout(function () { if (!el.classList.contains('gone')) { finished = true; target = 1; } }, 25000);   // never trap the page
})();
</script>
